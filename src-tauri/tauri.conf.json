{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PITCH",
  "version": "0.3.1",
  "identifier": "com.ronak.pitch",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PITCH",
        "width": 1080,
        "height": 700,
        "visible": false,
        "center": true,
        "minWidth": 560,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Ronak Jain",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
